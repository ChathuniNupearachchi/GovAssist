# Copy this file to .env and fill in your own values. Never commit .env.

# Postgres started by `docker compose up -d` at the repo root.
DATABASE_URL=postgresql://govassist:govassist@localhost:5432/govassist
REDIS_URL=redis://localhost:6379

# The tool-using agent that answers open citizen questions (the one
# citizen-facing job kept on a paid model — see CLAUDE.md's "How the
# LLM APIs are used"). Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Classification, rephrasing, acknowledgement and PDF-OCR fallback run
# on Gemini's free tier. A second key is optional — used as a fallback
# if the first is rate-limited. Get keys at https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_API_KEY_2=

# Cross-provider fallback for the Gemini-routed jobs above, used if
# Gemini itself is unavailable. Get a key at https://console.groq.com/
GROQ_API_KEY=

# Signs JWTs for /auth/signin and /auth/signup (item 7, saved plans).
# Any long random string — e.g. `python -c "import secrets; print(secrets.token_urlsafe(32))"`
JWT_SECRET_KEY=

# Optional — self-hosted Langfuse tracing (docker-compose.yml's
# langfuse service). Leave unset to run without tracing; the app
# degrades gracefully.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3030
