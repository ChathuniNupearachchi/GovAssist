# Copy this file to .env and fill in your own value.
#
# The GovAssist API's base URL, as reachable from your PHONE — not
# "localhost" (that resolves to the phone itself, not your laptop).
# On a physical device over the same Wi-Fi as your laptop, use your
# laptop's LAN IP. See the README's "Running on a physical device"
# section for how to find it, and for the matching
# `uvicorn --host 0.0.0.0` requirement on the backend side.
#
# Must be prefixed EXPO_PUBLIC_ to be readable in the app bundle
# (Expo's own convention — see https://docs.expo.dev/guides/environment-variables/).
EXPO_PUBLIC_API_BASE_URL=http://192.168.1.42:8000
